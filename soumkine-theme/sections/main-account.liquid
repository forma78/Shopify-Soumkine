<div class="page-width">
  <div class="customer customer--wide">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 16px;">
      <h1 class="h1">{{ 'customer.account.title' | t }}</h1>
      <a class="link-underline" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
    </div>
    <div class="page-layout" style="padding-top: 20px;">
      <div>
        <h2 class="h4" style="margin-bottom: 16px;">{{ 'customer.account.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table>
              <thead>
                <tr>
                  <th>{{ 'customer.orders.order' | t }}</th>
                  <th>{{ 'customer.orders.date' | t }}</th>
                  <th>{{ 'customer.orders.status' | t }}</th>
                  <th>{{ 'customer.orders.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a class="link-underline" href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_net_amount | money_with_currency }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <p>{{ 'customer.orders.none' | t }}</p>
          {%- endif -%}
          {%- render 'pagination', paginate: paginate -%}
        {%- endpaginate -%}
      </div>
      <div>
        <h2 class="h4" style="margin-bottom: 16px;">{{ 'customer.account.details' | t }}</h2>
        <p>{{ customer.name | escape }}</p>
        {{ customer.default_address | format_address }}
        <p style="margin-top: 16px;">
          <a class="link-underline" href="{{ routes.account_addresses_url }}">
            {{- 'customer.account.addresses' | t }} ({{ customer.addresses_count }})
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Account",
  "tag": "section",
  "class": "section-customer",
  "settings": []
}
{% endschema %}
