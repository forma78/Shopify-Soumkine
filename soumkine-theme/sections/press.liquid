<div class="section{% if section.settings.spacing == 'small' %} section--tight{% endif %}">
  <div class="page-width press reveal">
    {%- if section.settings.heading != blank -%}
      <h2 class="h3">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="press__logos" role="list">
      {%- for block in section.blocks -%}
        <li class="press__logo" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{%- endif -%}
          {%- if block.settings.logo != blank -%}
            {%- assign logo_alt = block.settings.name | default: block.settings.logo.alt | escape -%}
            {{ block.settings.logo | image_url: height: 80 | image_tag: loading: 'lazy', alt: logo_alt, widths: '160, 320' }}
          {%- else -%}
            <span class="press__logo-text">{{ block.settings.name | escape }}</span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Press",
  "tag": "section",
  "class": "section-press",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As seen in"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space above",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "default", "label": "Default" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Publication"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
