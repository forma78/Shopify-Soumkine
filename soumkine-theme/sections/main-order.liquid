<div class="page-width">
  <div class="customer customer--wide">
    <p><a class="link-underline" href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a></p>
    <h1 class="h1" style="margin-top: 16px;">{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p class="muted" style="margin-bottom: 28px;">{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
    {%- if order.cancelled -%}
      {%- assign cancelled_date = order.cancelled_at | time_tag: format: 'date' -%}
      <p>{{ 'customer.order.cancelled' | t: date: cancelled_date }}</p>
    {%- endif -%}
    <table>
      <thead>
        <tr>
          <th>{{ 'customer.order.product' | t }}</th>
          <th>{{ 'customer.order.quantity' | t }}</th>
          <th>{{ 'customer.orders.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              {{ line_item.title | link_to: line_item.product.url }}
              {%- if line_item.fulfillment %}<br><span class="muted">{{ line_item.fulfillment.created_at | time_tag: format: 'date' }}</span>{% endif -%}
            </td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="2">{{ 'cart.subtotal' | t }}</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
        {%- for shipping_method in order.shipping_methods -%}
          <tr><td colspan="2">{{ shipping_method.title }}</td><td>{{ shipping_method.price | money }}</td></tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr><td colspan="2">{{ tax_line.title }} ({{ tax_line.rate_percentage }}%)</td><td>{{ tax_line.price | money }}</td></tr>
        {%- endfor -%}
        <tr><td colspan="2">{{ 'customer.orders.total' | t }}</td><td>{{ order.total_net_amount | money_with_currency }}</td></tr>
      </tfoot>
    </table>
    <div class="page-layout">
      <div>
        <h2 class="h4" style="margin-bottom: 12px;">{{ 'customer.order.billing_address' | t }}</h2>
        {{ order.billing_address | format_address }}
      </div>
      {%- if order.shipping_address -%}
        <div>
          <h2 class="h4" style="margin-bottom: 12px;">{{ 'customer.order.shipping_address' | t }}</h2>
          {{ order.shipping_address | format_address }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Order",
  "tag": "section",
  "class": "section-customer",
  "settings": []
}
{% endschema %}
