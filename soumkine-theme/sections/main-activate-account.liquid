<div class="page-width">
  <div class="customer">
    <h1 class="h1">{{ 'customer.activate.title' | t }}</h1>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form-grid">
        <div class="field">
          <label class="field__label" for="ActivatePassword">{{ 'customer.login.password' | t }}</label>
          <input id="ActivatePassword" class="input" type="password" name="customer[password]" autocomplete="new-password">
        </div>
        <div class="field">
          <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.activate.confirm' | t }}</label>
          <input id="ActivatePasswordConfirm" class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password">
        </div>
      </div>
      <div class="customer__actions">
        <button class="button button--primary" type="submit">{{ 'customer.activate.submit' | t }}</button>
        <button class="button" type="submit" name="decline">{{ 'customer.activate.decline' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Activate account",
  "tag": "section",
  "class": "section-customer",
  "settings": []
}
{% endschema %}
