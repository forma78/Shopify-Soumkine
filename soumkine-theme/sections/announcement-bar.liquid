{%- if section.settings.text != blank -%}
  <div class="announcement-bar">
    {%- if section.settings.link != blank -%}
      <a class="link-hover" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      <span>{{ section.settings.text | escape }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Original paintings — shipped worldwide from Paris"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
