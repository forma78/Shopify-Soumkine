<div class="password-page">
  <div class="page-width" style="display: flex; justify-content: space-between; gap: 20px;">
    {%- if settings.wordmark_style == 'logo' -%}
      <span class="header__logo" style="--logo-height: 14px;">{%- render 'logo-wordmark', label: shop.name -%}</span>
    {%- else -%}
      <span>{{ settings.wordmark_text | default: shop.name | escape }}</span>
    {%- endif -%}
    <a class="link-hover" href="#PasswordLogin">{{ 'password.enter' | t }}</a>
  </div>

  <div class="page-width text-center">
    {%- if shop.password_message != blank -%}
      <p class="statement">{{ shop.password_message | escape }}</p>
    {%- endif -%}
    {%- if section.settings.show_newsletter -%}
      <div style="max-width: 520px; margin: 40px auto 0;">
        {%- form 'customer', id: 'PasswordNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="prospect,password page">
          {%- if form.posted_successfully? -%}
            <p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            <div class="inline-form">
              <label class="visually-hidden" for="PasswordNewsletterEmail">{{ 'newsletter.label' | t }}</label>
              <input id="PasswordNewsletterEmail" class="input" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" required>
              <button class="button button--primary" type="submit">{{ 'newsletter.button' | t }}</button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>

  <div>
    {%- render 'wordmark-lockup', show_signature: true, signature_position: 'stacked', class: 'lockup--solid' -%}
    <div class="page-width" id="PasswordLogin" style="max-width: 520px; margin: 60px auto 0;">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="inline-form">
          <label class="visually-hidden" for="PasswordInput">{{ 'password.label' | t }}</label>
          <input id="PasswordInput" class="input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
          <button class="button" type="submit">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
      <p class="muted small text-center" style="margin-top: 20px;">{{ 'password.admin_link_html' | t }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "section-password",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    }
  ]
}
{% endschema %}
