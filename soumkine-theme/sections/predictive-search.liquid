{%- comment -%}
  Rendered through /search/suggest?section_id=predictive-search.
{%- endcomment -%}
<div data-predictive-results>
  {%- if predictive_search.performed -%}
    {%- if predictive_search.resources.products.size > 0 -%}
      {%- for product in predictive_search.resources.products -%}
        <a class="predictive-results__item" href="{{ product.url }}">
          <span class="media" style="aspect-ratio: 0.8;">
            {%- if product.featured_media -%}
              {{
                product.featured_media.preview_image
                | image_url: width: 400
                | image_tag: loading: 'lazy', widths: '200, 400', sizes: '160px', alt: product.title
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="card__title">{{ product.title | escape }}</span>
          {%- render 'price', product: product, show_sold: true -%}
        </a>
      {%- endfor -%}
    {%- else -%}
      <p>{{ 'search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Predictive search",
  "settings": []
}
{% endschema %}
