{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif
  assign slider_ratio = section.settings.ratio
-%}
<div class="section{% if section.settings.spacing == 'small' %} section--tight{% endif %}">
  <div class="page-width section-split">
    <div class="section-split__aside reveal">
      {%- if section.settings.heading != blank -%}
        <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ collection.url | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <slider-component class="reveal">
      <div class="slider" data-slider-track>
        {%- if collection.products.size > 0 -%}
          {%- for product in collection.products limit: section.settings.limit -%}
            {%- render 'product-card',
              product: product,
              ratio: slider_ratio,
              sizes: '(min-width: 990px) 27vw, (min-width: 750px) 38vw, 72vw'
            -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            {%- render 'product-card', product: nil, ratio: slider_ratio, placeholder_index: i -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="slider-controls">
        <button type="button" data-slider-prev aria-label="{{ 'general.slider.previous' | t }}">
          {%- render 'icon', name: 'arrow-left' -%}
        </button>
        <button type="button" data-slider-next aria-label="{{ 'general.slider.next' | t }}">
          {%- render 'icon', name: 'arrow-right' -%}
        </button>
      </div>
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Collection slider",
  "tag": "section",
  "class": "section-collection-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Chromatic Series"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Horizons built line by line.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "All products when empty."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "natural", "label": "Original" }
      ],
      "default": "portrait"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space above",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "default", "label": "Default" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Collection slider"
    }
  ]
}
{% endschema %}
