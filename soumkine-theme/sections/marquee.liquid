{%- liquid
  assign marquee_text = section.settings.text | escape
  assign separator = section.settings.separator | escape
-%}
<div class="section{% if section.settings.spacing == 'none' %} section--flush{% elsif section.settings.spacing == 'small' %} section--tight{% endif %}">
  <div
    class="marquee marquee--{{ section.settings.style }}{% if section.settings.inverse %} color-inverse{% endif %}"
    style="--duration: {{ section.settings.speed }}s;"
    role="marquee"
    aria-label="{{ marquee_text }}"
  >
    <div class="marquee__track" aria-hidden="true">
      {%- for i in (1..8) -%}
        <span class="marquee__item">{{ marquee_text }}{% if separator != blank %} {{ separator }}{% endif %}</span>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrolling text",
  "tag": "section",
  "class": "section-marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Painted in Paris. One of a kind."
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "info": "Optional, e.g. — or ●"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "heading", "label": "Large" },
        { "value": "mono", "label": "Monospace" }
      ],
      "default": "heading"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Duration of one loop",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "inverse",
      "label": "Inverse colors",
      "default": false
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space above",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "default", "label": "Default" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "Scrolling text"
    }
  ]
}
{% endschema %}
