{%- comment -%}
  Commission enquiry. Uses Shopify's contact form: every field arrives in the store's contact email.
  "Project" is preselected by buttons with data-project, or by ?project= in the URL.
{%- endcomment -%}
{%- liquid
  assign form_id = 'CommissionForm-' | append: section.id
  assign anchor = section.settings.anchor | handle
  assign projects = section.settings.projects | split: ','
  assign formats = section.settings.formats | split: ','
-%}
<div
  {% if anchor != blank %}
    id="{{ anchor }}"
  {% endif %}
  class="section commission-form"
>
  <div class="page-width page-layout">
    <div class="section-split__aside">
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div>
      {%- form 'contact', id: form_id -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message h4" role="status">{{ section.settings.success_text | escape }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="form-grid form-grid--2">
            <div class="field">
              <label class="field__label" for="{{ form_id }}-name">{{ 'contact.name' | t }}</label>
              <input id="{{ form_id }}-name" class="input" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
            </div>
            <div class="field">
              <label class="field__label" for="{{ form_id }}-email">{{ 'contact.email' | t }} *</label>
              <input id="{{ form_id }}-email" class="input" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
            </div>
            <div class="field">
              <label class="field__label" for="{{ form_id }}-phone">{{ 'contact.phone' | t }}</label>
              <input id="{{ form_id }}-phone" class="input" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
            </div>
            <div class="field">
              <label class="field__label" for="{{ form_id }}-company">{{ 'commissions.form.company' | t }}</label>
              <input id="{{ form_id }}-company" class="input" type="text" name="contact[{{ 'commissions.form.company' | t }}]" autocomplete="organization">
            </div>
            <div class="field">
              <label class="field__label" for="{{ form_id }}-project">{{ 'commissions.form.project' | t }}</label>
              <div class="select-wrapper">
                <select id="{{ form_id }}-project" class="select" name="contact[{{ 'commissions.form.project' | t }}]" data-project-select>
                  {%- for project in projects -%}
                    <option value="{{ project | strip | escape }}">{{ project | strip | escape }}</option>
                  {%- endfor -%}
                </select>
                {%- render 'icon', name: 'chevron-down', class: 'icon--small' -%}
              </div>
            </div>
            <div class="field">
              <label class="field__label" for="{{ form_id }}-format">{{ 'commissions.form.format' | t }}</label>
              <div class="select-wrapper">
                <select id="{{ form_id }}-format" class="select" name="contact[{{ 'commissions.form.format' | t }}]">
                  {%- for format in formats -%}
                    <option value="{{ format | strip | escape }}">{{ format | strip | escape }}</option>
                  {%- endfor -%}
                </select>
                {%- render 'icon', name: 'chevron-down', class: 'icon--small' -%}
              </div>
            </div>
            <div class="field">
              <label class="field__label" for="{{ form_id }}-works">{{ 'commissions.form.works' | t }}</label>
              <input id="{{ form_id }}-works" class="input" type="text" inputmode="numeric" name="contact[{{ 'commissions.form.works' | t }}]">
            </div>
            <div class="field">
              <label class="field__label" for="{{ form_id }}-location">{{ 'commissions.form.location' | t }}</label>
              <input id="{{ form_id }}-location" class="input" type="text" name="contact[{{ 'commissions.form.location' | t }}]">
            </div>
            <div class="field form-grid__full">
              <label class="field__label" for="{{ form_id }}-timeline">{{ 'commissions.form.timeline' | t }}</label>
              <input id="{{ form_id }}-timeline" class="input" type="text" name="contact[{{ 'commissions.form.timeline' | t }}]" placeholder="{{ 'commissions.form.timeline_placeholder' | t }}">
            </div>
            <div class="field form-grid__full">
              <label class="field__label" for="{{ form_id }}-body">{{ 'commissions.form.message' | t }}</label>
              <textarea id="{{ form_id }}-body" class="textarea" name="contact[body]" placeholder="{{ 'commissions.form.message_placeholder' | t }}">{{ form.body }}</textarea>
            </div>
          </div>
          <p style="margin-top: 22px;">
            <button class="button button--primary button--large" type="submit">{{ section.settings.button_label | escape }}</button>
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Commission enquiry",
  "tag": "section",
  "class": "section-commission-form",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "enquire"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start a commission"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell us about your space: walls, light, palette, timeline. We’ll come back with a proposal.</p>"
    },
    {
      "type": "text",
      "id": "projects",
      "label": "Project types",
      "info": "Separate with commas. Commission offer buttons preselect one of these.",
      "default": "Hotel, Restaurant, Private collection, Other"
    },
    {
      "type": "text",
      "id": "formats",
      "label": "Formats",
      "info": "Separate with commas.",
      "default": "120 × 120 cm / 47 × 47 in, 160 × 160 cm / 63 × 63 in, 200 × 200 cm / 79 × 79 in, Custom, Not sure yet"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send enquiry"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Thank-you message",
      "default": "Thank you. We’ll be in touch shortly."
    }
  ],
  "presets": [
    {
      "name": "Commission enquiry"
    }
  ]
}
{% endschema %}
