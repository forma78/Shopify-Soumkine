{%- assign form_id = 'ContactForm-' | append: section.id -%}
<div class="page-width page-layout">
  <div class="section-split__aside">
    <h1 class="h1">{{ section.settings.heading | default: page.title | escape }}</h1>
    {%- if page.content != blank -%}
      <div class="rte">{{ page.content }}</div>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
  <div>
    {%- form 'contact', id: form_id -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message h4" role="status">{{ 'contact.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="form-grid form-grid--2">
          <div class="field">
            <label class="field__label" for="{{ form_id }}-name">{{ 'contact.name' | t }}</label>
            <input id="{{ form_id }}-name" class="input" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
          </div>
          <div class="field">
            <label class="field__label" for="{{ form_id }}-email">{{ 'contact.email' | t }} *</label>
            <input id="{{ form_id }}-email" class="input" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
          </div>
          <div class="field form-grid__full">
            <label class="field__label" for="{{ form_id }}-phone">{{ 'contact.phone' | t }}</label>
            <input id="{{ form_id }}-phone" class="input" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
          </div>
          {%- if section.settings.show_subject -%}
            <div class="field form-grid__full">
              <label class="field__label" for="{{ form_id }}-subject">{{ 'contact.subject' | t }}</label>
              <div class="select-wrapper">
                <select id="{{ form_id }}-subject" class="select" name="contact[subject]">
                  {%- assign subjects = section.settings.subjects | split: ',' -%}
                  {%- for subject in subjects -%}
                    <option value="{{ subject | strip | escape }}">{{ subject | strip | escape }}</option>
                  {%- endfor -%}
                </select>
                {%- render 'icon', name: 'chevron-down', class: 'icon--small' -%}
              </div>
            </div>
          {%- endif -%}
          <div class="field form-grid__full">
            <label class="field__label" for="{{ form_id }}-body">{{ 'contact.message' | t }}</label>
            <textarea id="{{ form_id }}-body" class="textarea" name="contact[body]">{{ form.body }}</textarea>
          </div>
        </div>
        <p style="margin-top: 20px;"><button class="button button--primary button--large" type="submit">{{ 'contact.send' | t }}</button></p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Uses the page title when empty."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_subject",
      "label": "Show subject",
      "default": true
    },
    {
      "type": "text",
      "id": "subjects",
      "label": "Subjects",
      "info": "Separate with commas.",
      "default": "A work in the shop, A commission, For spaces & interiors, Press, Something else"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
