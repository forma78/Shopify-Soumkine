{%- assign blog = section.settings.blog -%}
<div class="section{% if section.settings.spacing == 'small' %} section--tight{% endif %}">
  <div class="page-width section-split">
    <div class="section-split__aside reveal">
      {%- if section.settings.heading != blank -%}
        <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ blog.url | default: '#' }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="article-row">
      {%- if blog.articles.size > 0 -%}
        {%- for article in blog.articles limit: 3 -%}
          <div class="reveal">
            {%- render 'article-card', article: article, ratio: 1.5, sizes: '(min-width: 750px) 25vw, 100vw', show_date: section.settings.show_date -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="reveal">{%- render 'article-card', article: nil, ratio: 1.5 -%}</div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Journal",
  "tag": "section",
  "class": "section-blog-posts",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Notes from the atelier."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "More notes"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space above",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "default", "label": "Default" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Journal"
    }
  ]
}
{% endschema %}
