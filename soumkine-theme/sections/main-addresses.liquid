{%- paginate customer.addresses by 10 -%}
  <div class="page-width">
    <div class="customer customer--wide">
      <p><a class="link-underline" href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a></p>
      <h1 class="h1" style="margin-top: 16px;">{{ 'customer.addresses.title' | t }}</h1>

      <div class="page-layout">
        <div>
          {%- for address in customer.addresses -%}
            <div style="margin-bottom: 32px;">
              {%- if address == customer.default_address -%}<p class="muted">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
              {{ address | format_address }}
              <details class="accordion" style="margin-top: 10px;">
                <summary><span>{{ 'customer.addresses.edit' | t }}</span>{% render 'icon', name: 'chevron-down' %}</summary>
                <div class="accordion__content">
                  {%- form 'customer_address', address -%}
                    {%- render 'address-fields', form: form, prefix: address.id -%}
                    <div class="customer__actions">
                      <button class="button button--primary" type="submit">{{ 'customer.addresses.save' | t }}</button>
                    </div>
                  {%- endform -%}
                  <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" style="margin-top: 14px;">
                    <input type="hidden" name="_method" value="delete">
                    <button class="link-underline" type="submit">{{ 'customer.addresses.delete' | t }}</button>
                  </form>
                </div>
              </details>
            </div>
          {%- endfor -%}
          {%- render 'pagination', paginate: paginate -%}
        </div>
        <div>
          <h2 class="h4" style="margin-bottom: 16px;">{{ 'customer.addresses.add' | t }}</h2>
          {%- form 'customer_address', customer.new_address -%}
            {%- render 'address-fields', form: form, prefix: 'new' -%}
            <div class="customer__actions">
              <button class="button button--primary" type="submit">{{ 'customer.addresses.add' | t }}</button>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Addresses",
  "tag": "section",
  "class": "section-customer",
  "settings": []
}
{% endschema %}
