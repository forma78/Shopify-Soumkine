<div class="page-width">
  <div class="customer">
    <h1 class="h1">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form-grid">
        <div class="field">
          <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input id="RegisterFirstName" class="input" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input id="RegisterLastName" class="input" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterEmail">{{ 'customer.login.email' | t }}</label>
          <input id="RegisterEmail" class="input" type="email" name="customer[email]" autocomplete="email" value="{{ form.email }}">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterPassword">{{ 'customer.login.password' | t }}</label>
          <input id="RegisterPassword" class="input" type="password" name="customer[password]" autocomplete="new-password">
        </div>
      </div>
      <div class="customer__actions">
        <button class="button button--primary" type="submit">{{ 'customer.register.submit' | t }}</button>
        <a class="link-underline" href="{{ routes.account_login_url }}">{{ 'customer.login.title' | t }}</a>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Register",
  "tag": "section",
  "class": "section-customer",
  "settings": []
}
{% endschema %}
