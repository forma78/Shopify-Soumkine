<footer class="footer">
  {%- if section.settings.show_wordmark -%}
    {%- render 'wordmark-lockup',
      show_signature: section.settings.show_signature,
      signature_position: section.settings.signature_position,
      class: 'footer__lockup lockup--solid'
    -%}
  {%- endif -%}

  <div class="footer__grid">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'text' -%}
          <div class="footer__about" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.show_social -%}
              {%- render 'social-icons' -%}
            {%- endif -%}
          </div>
        {%- when 'menu' -%}
          <div class="footer__menu" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <p class="muted">{{ block.settings.heading | escape }}</p>
            {%- endif -%}
            <ul role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a class="link-hover" href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when 'newsletter' -%}
          <div class="footer__newsletter" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- assign form_id = 'FooterNewsletter-' | append: block.id -%}
            {%- form 'customer', id: form_id -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>
              {%- else -%}
                <div class="inline-form">
                  <label class="visually-hidden" for="{{ form_id }}-email">{{ 'newsletter.label' | t }}</label>
                  <input
                    id="{{ form_id }}-email"
                    class="input"
                    type="email"
                    name="contact[email]"
                    autocomplete="email"
                    placeholder="{{ 'newsletter.label' | t }}"
                    required
                  >
                  <button class="button button--primary" type="submit">{{ 'newsletter.button' | t }}</button>
                </div>
                {%- if form.errors -%}
                  <p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endif -%}
            {%- endform -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <div class="footer__legal">
      <div class="footer__legal-links small">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</span>
        {%- if section.settings.show_powered_by -%}
          <span>{{ powered_by_link }}</span>
        {%- endif -%}
        {%- if section.settings.show_policies -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <a class="link-hover" href="{{ policy.url }}">{{ policy.title | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-icons" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- liquid
      assign show_countries = false
      if section.settings.show_country_selector and localization.available_countries.size > 1
        assign show_countries = true
      endif
      assign show_languages = false
      if section.settings.show_language_selector and localization.available_languages.size > 1
        assign show_languages = true
      endif
    -%}
    {%- if show_countries or show_languages -%}
      {%- form 'localization', class: 'localization-form' -%}
        {%- if show_countries -%}
          <div class="select-wrapper">
            <label class="visually-hidden" for="FooterCountry">{{ 'localization.country_label' | t }}</label>
            <select id="FooterCountry" class="select" name="country_code" data-autosubmit>
              {%- for country in localization.available_countries -%}
                <option
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
            {%- render 'icon', name: 'chevron-down', class: 'icon--small' -%}
          </div>
        {%- endif -%}
        {%- if show_languages -%}
          <div class="select-wrapper">
            <label class="visually-hidden" for="FooterLanguage">{{ 'localization.language_label' | t }}</label>
            <select id="FooterLanguage" class="select" name="language_code" data-autosubmit>
              {%- for language in localization.available_languages -%}
                <option
                  value="{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ language.endonym_name | capitalize }}
                </option>
              {%- endfor -%}
            </select>
            {%- render 'icon', name: 'chevron-down', class: 'icon--small' -%}
          </div>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show large wordmark",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_signature",
      "label": "Show signature",
      "default": true
    },
    {
      "type": "select",
      "id": "signature_position",
      "label": "Signature position",
      "options": [
        { "value": "overlap", "label": "Over the wordmark" },
        { "value": "under", "label": "Under the wordmark" },
        { "value": "stacked", "label": "Centered, as the logo" }
      ],
      "default": "stacked"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show “Powered by Shopify”",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country / currency selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show language selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Original paintings on canvas, made in a small Paris atelier.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social icons",
          "default": true
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New works, first. Nothing else."
        }
      ]
    }
  ]
}
{% endschema %}
