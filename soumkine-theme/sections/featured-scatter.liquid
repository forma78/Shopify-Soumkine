{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif
  assign products = collection.products
-%}
<div class="section{% if section.settings.spacing == 'small' %} section--tight{% endif %}">
  <div class="page-width">
    <div class="scatter{% if section.settings.compact %} scatter--compact{% endif %}">
      {%- if section.settings.title != blank -%}
        <h2 class="scatter__title h-display{% if section.settings.title_position == 'top' %} scatter__title--static{% endif %}">
          {{- section.settings.title | escape -}}
        </h2>
      {%- endif -%}
      {%- render 'scatter-products',
        products: products,
        limit: section.settings.limit,
        ratio: section.settings.ratio,
        parallax: section.settings.parallax
      -%}
    </div>
    {%- if section.settings.view_all_label != blank and collection != blank -%}
      <div class="text-center section--tight">
        <a class="button" href="{{ collection.url }}">{{ section.settings.view_all_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Scattered collection",
  "tag": "section",
  "class": "section-featured-scatter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Latest Works"
    },
    {
      "type": "select",
      "id": "title_position",
      "label": "Title position",
      "options": [
        { "value": "overlap", "label": "Among the works" },
        { "value": "top", "label": "Above the works" }
      ],
      "default": "overlap"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "All products when empty."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image ratio",
      "options": [
        { "value": "natural", "label": "Original" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "natural"
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Parallax",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Tighter spacing",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all works"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space above",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "default", "label": "Default" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Scattered collection"
    }
  ]
}
{% endschema %}
