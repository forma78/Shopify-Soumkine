{%- liquid
  assign video = section.settings.video
  assign poster = section.settings.poster
  assign video_ratio = section.settings.ratio_fallback
  if video != blank
    assign video_ratio = video.aspect_ratio
  endif
  case section.settings.height
    when 'small'
      assign min_height = '60vh'
    when 'large'
      assign min_height = '100vh'
    when 'adapt'
      assign min_height = '0px'
    else
      assign min_height = '88vh'
  endcase
-%}
<video-feature
  data-autoplay="{{ section.settings.autoplay }}"
  data-respect-motion="{{ section.settings.respect_reduced_motion }}"
  class="video-feature color-inverse video-feature--{{ section.settings.layout }} video-feature--{{ section.settings.content_position }}"
  style="--min-height: {{ min_height }}; --overlay: {{ section.settings.overlay | divided_by: 100.0 }}; --video-ratio: {{ video_ratio }}; --frame-width: {{ section.settings.frame_width }}%;"
>
  <div class="video-feature__media"{% if section.settings.layout == 'full' and section.settings.height == 'adapt' %} style="position: relative; aspect-ratio: {{ video_ratio }};"{% endif %}>
    {%- if video != blank -%}
      {{
        video
        | video_tag:
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'metadata',
          image_size: '1920x'
      }}
    {%- elsif section.settings.video_url != blank -%}
      <video
        muted
        loop
        playsinline
        preload="metadata"
        {% if poster != blank %}
          poster="{{ poster | image_url: width: 1920 }}"
        {% endif %}
      >
        <source src="{{ section.settings.video_url | escape }}" type="video/mp4">
      </video>
    {%- elsif poster != blank -%}
      {{ poster | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank -%}
    <div class="video-feature__content">
      {%- if section.settings.eyebrow != blank -%}
        <p>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="video-feature__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button button--primary" href="{{ section.settings.button_link | default: '#' }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- liquid
    assign has_video = false
    if video != blank or section.settings.video_url != blank
      assign has_video = true
    endif
  -%}
  {%- if has_video and section.settings.show_toggle -%}
    <button class="video-feature__toggle button" type="button" data-video-toggle>
      <span data-label-pause hidden>{%- render 'icon', name: 'pause' -%}{{ 'general.video.pause' | t }}</span>
      <span data-label-play>{%- render 'icon', name: 'play' -%}{{ 'general.video.play' | t }}</span>
    </button>
  {%- endif -%}
</video-feature>

{% schema %}
{
  "name": "Video feature",
  "tag": "section",
  "class": "section-video-feature",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload under Content › Files, then select here. Plays muted, on a loop."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Or MP4 URL",
      "info": "Used when no video is selected."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Cover image",
      "info": "Shown while the video loads, or instead of a video."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "framed", "label": "Framed on black" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "frame_width",
      "label": "Frame width",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 56
    },
    {
      "type": "number",
      "id": "ratio_fallback",
      "label": "Video ratio for MP4 URL",
      "info": "Width divided by height. 1.5 for 3:2, 1.78 for 16:9.",
      "default": 1.5
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Full screen" },
        { "value": "adapt", "label": "Adapt to video" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Darken video",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Playback"
    },
    {
      "type": "select",
      "id": "autoplay",
      "label": "Autoplay",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "never", "label": "Off" }
      ],
      "default": "always",
      "info": "Plays muted, on a loop, while the section is on screen."
    },
    {
      "type": "checkbox",
      "id": "show_toggle",
      "label": "Show play / pause button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "respect_reduced_motion",
      "label": "Don’t autoplay when the device asks for reduced motion",
      "default": false
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Position",
      "options": [
        { "value": "bottom", "label": "Bottom" },
        { "value": "center", "label": "Center" }
      ],
      "default": "bottom"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text",
      "default": "Atelier, Paris"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The machine holds the brush"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "The process"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Video feature"
    }
  ]
}
{% endschema %}
