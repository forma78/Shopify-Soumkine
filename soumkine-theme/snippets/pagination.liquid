{%- comment -%}
  Accepts: paginate (object)
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
    {%- if paginate.previous -%}
      <a class="link-hover" href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a class="link-hover" href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="link-hover" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span>{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a class="link-hover" href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>
    {%- endif -%}
  </nav>
{%- endif -%}
