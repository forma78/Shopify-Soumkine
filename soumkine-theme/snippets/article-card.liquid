{%- comment -%}
  Accepts: article (object), ratio (number), sizes (string), show_date (boolean), placeholder_index (number)
{%- endcomment -%}
{%- assign article_ratio = ratio | default: 1.5 -%}
<div class="article-card">
  {%- if article != blank -%}
    <a href="{{ article.url }}">
      <div class="article-card__media">
        <div class="media" style="--ratio: {{ article_ratio }};">
          {%- if article.image -%}
            {{
              article.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 1000, 1400',
                sizes: sizes,
                alt: article.image.alt
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
      </div>
      <span class="article-card__title">{{ article.title | escape }}</span>
      {%- if show_date -%}
        <span class="muted"> — {{ article.published_at | time_tag: format: 'date' }}</span>
      {%- endif -%}
    </a>
  {%- else -%}
    <div class="article-card__media">
      <div class="media" style="--ratio: {{ article_ratio }};">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    </div>
    <span>{{ 'blogs.article.placeholder_title' | t }}</span>
  {%- endif -%}
</div>
