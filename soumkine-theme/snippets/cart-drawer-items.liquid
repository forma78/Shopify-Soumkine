{%- comment -%}
  Inner content of the cart drawer. Re-rendered via the Section Rendering API (sections/cart-drawer.liquid).
{%- endcomment -%}
<cart-items class="drawer__content-wrap" data-section-id="cart-drawer" data-cart-count-value="{{ cart.item_count }}" style="display: contents;">
  <div class="drawer__header">
    <h2 class="mono" id="CartDrawerTitle">{{ 'cart.title' | t }} (<span data-cart-count>{{ cart.item_count }}</span>)</h2>
    <button class="icon-button drawer__close" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
      {%- render 'icon', name: 'close', class: 'icon--large' -%}
    </button>
  </div>
  <div class="drawer__body">
    {%- if cart.item_count > 0 -%}
      <div class="cart-items">
        {%- for item in cart.items -%}
          {%- render 'cart-line', item: item, index: forloop.index -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="cart-empty">
        <p class="h3">{{ 'cart.empty' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </div>
    {%- endif -%}
    <p class="form-message form-message--error" data-cart-error role="alert" hidden></p>
  </div>
  {%- if cart.item_count > 0 -%}
    <div class="drawer__footer">
      {%- for discount in cart.cart_level_discount_applications -%}
        <div class="cart-summary__row">
          <span>{{ discount.title | escape }}</span>
          <span>-{{ discount.total_allocated_amount | money }}</span>
        </div>
      {%- endfor -%}
      <div class="cart-summary__row">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span>{{ cart.total_price | money_with_currency }}</span>
      </div>
      <p class="cart-summary__note small">{{ 'cart.taxes_and_shipping' | t }}</p>
      <form action="{{ routes.cart_url }}" method="post" class="cart-summary__buttons">
        <button class="button button--primary button--full" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        <a class="button button--full" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
      </form>
    </div>
  {%- endif -%}
</cart-items>
